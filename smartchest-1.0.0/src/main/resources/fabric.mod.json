{
	"schemaVersion": 1,
	"id": "smartchest",
	"version": "${version}",
	"name": "Baú Inteligente",
	"description": "Um baú que reúne os itens dos baús e barris vinculados a ele, com pesquisa no idioma do jogo. Só no servidor: os jogadores não precisam instalar nada.",
	"authors": ["ivanils0n"],
	"contact": {
		"sources": "https://github.com/ivanils0n/MC-Mods"
	},
	"license": "MIT",
	"environment": "*",
	"mixins": ["smartchest.mixins.json"],
	"entrypoints": {
		"main": ["io.github.ivanils0n.smartchest.SmartChest"]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25"
	}
}
